{
 "rules": [
  {
   "match": "^\\s*\\[\\[?[^\\]\\n]*\\]\\]?",
   "kind": "heading",
   "flags": "m"
  },
  {
   "match": "^\\s*[A-Za-z0-9_.\"'-]+(?=\\s*=)",
   "kind": "attribute",
   "flags": "m"
  },
  {
   "match": "\\d{4}-\\d{2}-\\d{2}([Tt ]\\d{2}:\\d{2}(:\\d{2}(\\.\\d+)?)?)?(Z|[+-]\\d{2}:\\d{2})?",
   "kind": "constant"
  }
 ],
 "lineComment": "#",
 "strings": [
  "\"\"\"",
  "'''",
  "\"",
  "'"
 ],
 "constants": [
  "true",
  "false",
  "inf",
  "nan"
 ]
}
