{
  "format": "wmkeyboard-plugin",
  "id": "com.wasimaster.syntaxpack",
  "name": "Syntax Pack",
  "pluginVersion": "1.0.0",
  "author": "Wasi Master",
  "description": "Colours config, build and data files the keyboard's file manager shows as plain text: TOML, INI and .conf files, YAML, .env files, Dockerfiles, Makefiles, CMake, Gradle scripts, Terraform and HCL, Nix, Zig, GraphQL, Protocol Buffers, diffs and patches, log files, and .gitignore-style lists. Needs no permissions: it only lists the words and patterns of each language.",
  "apiVersion": 5,
  "language": "python",
  "entry": "main.py",
  "panel": false,
  "tool": {"icon": "code", "color": "#546E7A"},
  "syntax": [
    {"id": "toml", "name": "TOML", "extensions": ["toml"], "names": ["Cargo.lock", "Pipfile", "poetry.lock"], "grammar": "assets/toml.json"},
    {"id": "ini", "name": "INI", "extensions": ["ini", "cfg", "conf", "cnf", "properties", "desktop", "service", "timer", "socket", "mount", "editorconfig", "gitconfig", "inf", "reg", "url", "prefs"],
     "names": [".gitconfig", ".editorconfig", ".npmrc", ".pylintrc", "setup.cfg", "tox.ini", "pytest.ini", "gradle.properties", "local.properties", ".gitmodules"], "grammar": "assets/ini.json"},
    {"id": "yaml", "name": "YAML", "extensions": ["yaml", "yml"], "names": [".clang-format", ".clang-tidy"], "grammar": "assets/yaml.json"},
    {"id": "dotenv", "name": ".env", "extensions": ["env"], "names": [".env", ".env.local", ".env.example", ".env.sample", ".env.development", ".env.production", ".env.test", ".envrc", ".flaskenv"], "grammar": "assets/dotenv.json"},
    {"id": "dockerfile", "name": "Dockerfile", "extensions": ["dockerfile", "containerfile"], "names": ["Dockerfile", "Containerfile", "Dockerfile.dev", "Dockerfile.prod"], "grammar": "assets/dockerfile.json"},
    {"id": "makefile", "name": "Makefile", "extensions": ["mk", "mak", "make"], "names": ["Makefile", "makefile", "GNUmakefile", "Kbuild", "Android.mk", "Application.mk"], "grammar": "assets/makefile.json"},
    {"id": "cmake", "name": "CMake", "extensions": ["cmake"], "names": ["CMakeLists.txt", "CMakeCache.txt"], "grammar": "assets/cmake.json"},
    {"id": "gradle", "name": "Gradle", "extensions": ["kts", "gradle"], "grammar": "assets/gradle.json"},
    {"id": "hcl", "name": "Terraform", "extensions": ["tf", "tfvars", "hcl", "nomad", "tftest.hcl"], "names": [".terraformrc", "terraform.rc"], "grammar": "assets/hcl.json"},
    {"id": "nix", "name": "Nix", "extensions": ["nix"], "names": ["flake.lock"], "grammar": "assets/nix.json"},
    {"id": "zig", "name": "Zig", "extensions": ["zig", "zon"], "grammar": "assets/zig.json"},
    {"id": "graphql", "name": "GraphQL", "extensions": ["graphql", "gql", "graphqls"], "grammar": "assets/graphql.json"},
    {"id": "proto", "name": "Protocol Buffers", "extensions": ["proto"], "grammar": "assets/proto.json"},
    {"id": "diff", "name": "Diff", "extensions": ["diff", "patch", "rej", "debdiff"], "grammar": "assets/diff.json"},
    {"id": "log", "name": "Log", "extensions": ["log", "logcat", "out", "err"], "names": ["logcat.txt", "bugreport.txt", "nohup.out"], "grammar": "assets/log.json"},
    {"id": "ignore", "name": "Ignore list", "extensions": ["gitignore", "dockerignore", "ignore"],
     "names": [".gitignore", ".dockerignore", ".npmignore", ".prettierignore", ".eslintignore", ".hgignore", ".gcloudignore", ".slugignore", ".vercelignore", ".helmignore", ".stignore", ".rgignore", ".fdignore", ".ignore", ".gitattributes", "CODEOWNERS"],
     "grammar": "assets/ignore.json"}
  ]
}
